# cp .env.example .env  후에 값 채우기. .env는 gitignore 되어 있음.
DB_PASSWORD=1234

# RAG 켤 때 필요
OPENAI_API_KEY=sk-...

# 원본 파일 저장용 S3. 액세스 키는 안 씀 — EC2에 IAM 역할 붙여서 인증.
S3_BUCKET=baton-uploads
S3_REGION=ap-northeast-2

# Slack 사용자 OAuth 연동. 실제 Client Secret·Signing Secret·암호화 키는 절대 Git에 커밋하지 않는다.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# 생성: openssl rand -base64 32
SLACK_TOKEN_ENCRYPTION_KEY=
# 로컬은 8081, 운영은 공개 HTTPS API 도메인으로 변경
SLACK_REDIRECT_URI=http://127.0.0.1:8081/api/v1/integrations/slack/oauth/callback
# Slack API 호출 제한을 고려한 증분 동기화 주기(밀리초)
SLACK_SYNC_INTERVAL_MS=60000
